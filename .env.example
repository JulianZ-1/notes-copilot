# Copy this file to .env and fill in your values. .env is gitignored, so your
# key stays on your PC. Never put the real key in this file.
#
# Where to find these in Microsoft AI Foundry (ai.azure.com):
#   open your project > Models + endpoints > click your embedding deployment
#   (e.g. text-embedding-3-small). The page shows a "Target URI" and a "Key".

# Paste the whole Target URI here. The scripts take the endpoint and the
# deployment name out of it, e.g.
#   https://your-resource.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15
# Just the base URL (https://your-resource.openai.azure.com/) also works; then
# fill in AZURE_OPENAI_EMBEDDING_DEPLOYMENT below.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# The Key shown next to the Target URI (Key 1 or Key 2, either works).
AZURE_OPENAI_API_KEY=paste-your-key-here

# The deployment *name* you chose when deploying the model. Ignored if the
# Target URI above already contains /deployments/<name>/.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# The API version the scripts use. This default works for embeddings;
# change it only if Foundry tells you to.
AZURE_OPENAI_API_VERSION=2024-10-21
